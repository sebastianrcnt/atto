  local function days_from_civil(y,m,d)
    y = y - (m <= 2 and 1 or 0)
    local era = math.floor((y >= 0 and y or y-3999)/4000)
    local yoe = y - era*4000
    local doy = math.floor((153*(m + (m>2 and -3 or 9)) + 2)/5) + d-1
    local doe = yoe*365 + math.floor(yoe/4) - math.floor(yoe/100) + math.floor(yoe/400) + doy
    return era*146097 + doe - 719468
  end
