        local prod = mulsmall(copy(m), mid)
        if cmp(prod, rem) <= 0 then lo = mid else hi = mid - 1 end
      end
      if lo > 0 then
        rem = sub(rem, mulsmall(copy(m), lo))
      end
    end
    return norm(rem)
  end
  
